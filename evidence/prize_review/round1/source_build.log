def JSP612.IsChromaticCritical.{u_1} : {V : Type u_1} → SimpleGraph V → ℕ → Prop :=
fun {V} G k => G.chromaticNumber = ↑k ∧ ∀ (J : G.Subgraph), J ≠ ⊤ → J.coe.chromaticNumber < ↑k
def JSP612.attainableCounts : ℕ → ℕ → Set ℕ :=
fun k n => {m | ∃ G E, JSP612.IsChromaticCritical G k ∧ ↑E ⊆ G.edgeSet ∧ E.card = m ∧ (G.deleteEdges ↑E).Colorable 2}
def JSP612.extremalDeletionNumber : ℕ → ℕ → ℕ∞ :=
fun k n => sInf ((fun m => ↑m) '' JSP612.attainableCounts k n)
def JSP612.originalExtremalConjecture : Prop :=
∀ (k : ℕ), 4 ≤ k → ∀ (b : ℕ), ∃ N, ∀ n ≥ N, ↑b < JSP612.extremalDeletionNumber k n
JSP612.jsp000612 (k : ℕ) (hk : 3 ≤ k) (N : ℕ) :
  ∃ V G E,
    Finite V ∧
      N ≤ Nat.card V ∧
        JSP612.IsChromaticCritical G k ∧ ↑E ⊆ G.edgeSet ∧ E.card ≤ (k - 1).choose 2 ∧ (G.deleteEdges ↑E).Colorable 2
JSP612.bounded_attained_minima (k : ℕ) (hk : 3 ≤ k) (N : ℕ) :
  ∃ n ≥ N, ∃ m, 0 < m ∧ m ≤ (k - 1).choose 2 ∧ m ∈ JSP612.attainableCounts k n ∧ JSP612.extremalDeletionNumber k n = ↑m
JSP612.originalExtremalConjecture_false : ¬JSP612.originalExtremalConjecture
JSP612.extremal_not_tendsto_infinity (k : ℕ) (hk : 3 ≤ k) :
  ¬Filter.Tendsto (JSP612.extremalDeletionNumber k) Filter.atTop (nhds ⊤)
JSP612.no_divergence_on_admissible_orders (k : ℕ) (hk : 3 ≤ k) :
  ¬∀ (b : ℕ), ∃ N, ∀ n ≥ N, (JSP612.attainableCounts k n).Nonempty → ↑b < JSP612.extremalDeletionNumber k n
